# Copy to .env.local for local dev, and set the same keys in the Vercel
# project's Environment Variables for production.

# Supabase — from the project's API settings.
NEXT_PUBLIC_SUPABASE_URL=https://uozvukypycqqrdelndhr.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Outbound email — your Hostinger mailbox (info@productionx.in). Used to
# email leads and send quotations/invoices from the admin dashboard.
# Hostinger's SMTP is smtp.hostinger.com on port 465 (SSL).
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=info@productionx.in
SMTP_PASS=
SMTP_FROM=info@productionx.in

# Facebook Page (Meta Graph API) — used by /api/social/facebook/posts.
# META_PAGE_ACCESS_TOKEN is a secret: generate it in Meta Graph API Explorer
# for the "ProductionX" app / "Production X Creative" Page, and paste it only
# into Vercel's Environment Variables (or your local .env.local) — never into
# code, chat, or a commit. Page access tokens issued this way are long-lived
# but not permanent; if the /api/social/facebook/posts route starts returning
# a 401 "expired or invalid" error, generate a new one here and update it.
META_PAGE_ID=333837236468591
META_PAGE_ACCESS_TOKEN=
