# Copy to .env.local for local dev, and set the same keys in the Vercel
# project's Environment Variables for production.

# Supabase — from the project's API settings.
NEXT_PUBLIC_SUPABASE_URL=https://uozvukypycqqrdelndhr.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Outbound email — your Hostinger mailbox (info@productionx.in). Used to
# email leads and send quotations/invoices from the admin dashboard.
# Hostinger's SMTP is smtp.hostinger.com on port 465 (SSL).
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=info@productionx.in
SMTP_PASS=
SMTP_FROM=info@productionx.in

# Facebook Page (Meta Graph API) — used by /api/social/facebook/posts.
# META_PAGE_ACCESS_TOKEN is a secret: generate it in Meta Graph API Explorer
# for the "ProductionX" app / "Production X Creative" Page, and paste it only
# into Vercel's Environment Variables (or your local .env.local) — never into
# code, chat, or a commit. Page access tokens issued this way are long-lived
# but not permanent; if the /api/social/facebook/posts route starts returning
# a 401 "expired or invalid" error, generate a new one here and update it.
META_PAGE_ID=333837236468591
META_PAGE_ACCESS_TOKEN=

# Instagram (Meta Graph API) — used by the Instagram tab on /admin/social.
# Reuses META_PAGE_ACCESS_TOKEN above; the token just needs to have been
# generated with the instagram_basic permission granted (re-generate it in
# Graph API Explorer with that box checked if Instagram shows a 401).
# META_IG_USER_ID is the Instagram *Business Account ID* — not the @handle,
# and not the same as META_PAGE_ID. Get it by querying, in Graph API
# Explorer, with the same Page token:
#   GET /333837236468591?fields=instagram_business_account
# The response's instagram_business_account.id is this value.
META_IG_USER_ID=

# YouTube (YouTube Data API v3) — used by the YouTube tab on /admin/social.
# Read-only listing of a public channel's uploads only needs an API key, not
# full OAuth — so there's no separate token to manage or expire here.
#   1. In Google Cloud Console: create/select a project, enable the
#      "YouTube Data API v3", then create an API key under Credentials.
#      Restrict the key to that API only.
#   2. YOUTUBE_CHANNEL_ID is the channel's ID (starts with "UC..."), found
#      under the channel's About tab -> Share channel -> Copy channel ID.
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=

# Marketing snapshots (daily Facebook/Instagram Insights capture).
# SUPABASE_SERVICE_ROLE_KEY — from the Supabase project's API settings
# (Settings -> API -> service_role key). Bypasses RLS: used ONLY by the
# scheduled snapshot cron (app/api/marketing/cron/route.ts), which has no
# admin session to scope a normal client to. Treat this like a master
# password — never expose it client-side, never reuse it elsewhere.
SUPABASE_SERVICE_ROLE_KEY=
# CRON_SECRET — any long random string you generate yourself. Vercel sends
# it back as a Bearer token when it fires the scheduled job (vercel.json),
# which is how the cron route knows the request is really from Vercel Cron.
CRON_SECRET=

# Meta Ads (used by /admin/marketing/paid). Reuses META_PAGE_ACCESS_TOKEN —
# no second token. Two things are required before this returns real data:
#   1. The token needs the ads_read permission, which the current one does
#      not have (confirmed via Graph API Explorer's Access Token Debugger).
#      Regenerating it with ads_read checked is a decision only you should
#      make — not done automatically by anything in this codebase.
#   2. META_AD_ACCOUNT_ID — your Meta Ads Manager account ID, found in Ads
#      Manager's URL or account settings (numeric, with or without the
#      "act_" prefix — either works, it's normalized in code).
# Until both exist, /admin/marketing/paid shows an honest "not connected"
# state and explains which of the two is still missing.
META_AD_ACCOUNT_ID=
