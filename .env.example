# Copy to .env.local for local dev, and set the same keys in the Vercel
# project's Environment Variables for production.

# Supabase — from the project's API settings.
NEXT_PUBLIC_SUPABASE_URL=https://uozvukypycqqrdelndhr.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Outbound email — your Hostinger mailbox (info@productionx.in). Used to
# email leads and send quotations/invoices from the admin dashboard.
# Hostinger's SMTP is smtp.hostinger.com on port 465 (SSL).
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=info@productionx.in
SMTP_PASS=
SMTP_FROM=info@productionx.in
